# Vercel (frontend) environment variables
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_API_URL=https://your-worker.up.railway.app   # Railway public URL

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # used only by the OAuth callback to create the session

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_API_BASE=https://api.pinterest.com/v5
ENCRYPTION_SECRET=              # 32+ random chars; MUST equal the Railway value
