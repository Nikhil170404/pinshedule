# Railway service variables (set these in the Railway dashboard)
PORT=8080
APP_URL=https://your-app.vercel.app          # exact frontend origin, used for CORS
CORS_ORIGINS=                                # optional extra origins, comma separated

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ENCRYPTION_SECRET=                           # 32+ random chars; MUST equal the Vercel value

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_API_BASE=https://api.pinterest.com/v5

OPENAI_API_KEY=                              # gpt-4o-mini + text-embedding-3-small

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_STARTER_YEARLY=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_GROWTH_MONTHLY=
RAZORPAY_PLAN_GROWTH_YEARLY=

# Optional: error tracking and email alerts
SENTRY_DSN=                                  # Sentry project DSN; worker and browser errors are reported when set
RESEND_API_KEY=                              # resend.com key; enables verified email alerts
EMAIL_FROM=GoPinKaro <notifications@gopinkaro.com>   # must be a domain verified in Resend
PUBLIC_API_URL=                              # this API's public URL, used in email links (defaults to RAILWAY_PUBLIC_DOMAIN)

RUN_JOBS=true
