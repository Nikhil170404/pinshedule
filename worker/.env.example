# Railway service variables (set these in the Railway dashboard)
PORT=8080
APP_URL=https://your-app.vercel.app          # exact frontend origin, used for CORS
CORS_ORIGINS=                                # optional extra origins, comma separated

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ENCRYPTION_SECRET=                           # 32+ random chars; MUST equal the Vercel value

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_API_BASE=https://api.pinterest.com/v5

OPENAI_API_KEY=                              # gpt-4o-mini + text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1-mini          # AI background images in the pin designer (low quality, 1024x1536)

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_STARTER_YEARLY=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_GROWTH_MONTHLY=
RAZORPAY_PLAN_GROWTH_YEARLY=

RUN_JOBS=true
